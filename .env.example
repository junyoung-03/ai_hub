# Phase 1: copy to .env.local and use the ai-hub-dev project configuration.
# These two values are public. Never use a secret or service_role key for them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Google Data OAuth credentials. Never add NEXT_PUBLIC_.
GOOGLE_DATA_CLIENT_ID=
GOOGLE_DATA_CLIENT_SECRET=
GOOGLE_DATA_REDIRECT_URI=http://localhost:3000/api/v1/connections/google/callback

# 32 random bytes encoded as standard base64. Keep server-only and rotate deliberately.
GOOGLE_DATA_TOKEN_ENCRYPTION_KEY=

# Server-only Supabase credential for the narrow Google token RPCs.
# Prefer SUPABASE_SECRET_KEY; SUPABASE_SERVICE_ROLE_KEY is a legacy fallback.
SUPABASE_SECRET_KEY=

# Phase 6A server-only Structured Output; select the model explicitly.
GEMINI_API_KEY=
GEMINI_MODEL=
