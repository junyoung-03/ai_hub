{
  "type": "object",
  "title": "AIHubItemAnalysisV01",
  "description": "AI 통합 정보 허브의 단일 ITEM 분석 결과. AI는 후보와 관찰값만 반환하며 최종 DB 권한·소유권·중복병합·Action Deadline 확정은 서버가 수행한다.",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "0.1"
      ],
      "description": "Structured Output schema version."
    },
    "classification": {
      "type": "object",
      "description": "AI가 생성한 분류값. 사용자 override 값은 포함하거나 변경하지 않는다.",
      "properties": {
        "primaryTopic": {
          "type": "string",
          "description": "문서의 핵심 Primary Topic 1개. 기존 Topic 후보가 입력에 제공되면 의미가 유사한 기존 Topic을 우선 재사용한다."
        },
        "documentType": {
          "type": "string",
          "enum": [
            "notice",
            "application",
            "contract",
            "billing",
            "reservation",
            "certificate",
            "schedule",
            "general",
            "other"
          ],
          "description": "v1 Document Type."
        },
        "tags": {
          "type": "array",
          "maxItems": 12,
          "description": "검색·분류 보조용 세부 키워드. 중복 없이 핵심어만 반환한다.",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "primaryTopic",
        "documentType",
        "tags"
      ],
      "additionalProperties": false
    },
    "actions": {
      "type": "array",
      "maxItems": 10,
      "description": "이 ITEM에서 실제로 사용자가 해야 하거나 선택하거나 확인해야 하는 행동 후보. 날짜가 있다는 이유만으로 Action을 만들지 않는다.",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "사용자가 해야 할 행동을 짧고 구체적으로 표현한 제목."
          },
          "actionType": {
            "type": "string",
            "enum": [
              "required",
              "optional",
              "check"
            ],
            "description": "required=반드시 해야 함, optional=신청·선택, check=조건 확인 필요."
          },
          "requirements": {
            "type": "array",
            "maxItems": 10,
            "description": "행동 수행에 필요한 제출물·준비물·절차 등. 근거가 없으면 빈 배열.",
            "items": {
              "type": "string"
            }
          },
          "conditions": {
            "type": "array",
            "maxItems": 10,
            "description": "대상자 조건·자격·예외·선행조건 등. 근거가 없으면 빈 배열.",
            "items": {
              "type": "string"
            }
          },
          "startObservation": {
            "type": "object",
            "description": "신청/접수 시작 시점에 대한 이 ITEM 내부 관찰값. 행사일과 혼동하지 않는다.",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "confirmed",
                  "needs_review",
                  "none"
                ]
              },
              "date": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date",
                "description": "원문에 명확히 확인되는 YYYY-MM-DD. 추측하지 않는다."
              },
              "datetime": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "원문에 날짜와 시간이 모두 명확한 경우만 반환. 시간대도 근거 없이 추정하지 않는다."
              },
              "rawText": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "원문에 나타난 시작 시점 표현. 없으면 null."
              },
              "evidence": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "시작 시점을 직접 뒷받침하는 원문 근거."
                  },
                  "locator": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "text_span",
                          "page",
                          "email_section",
                          "calendar_field",
                          "metadata",
                          "unknown"
                        ]
                      },
                      "page": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "section": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "startChar": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "endChar": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "field": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "page",
                      "section",
                      "startChar",
                      "endChar",
                      "field"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "text",
                  "locator"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "status",
              "date",
              "datetime",
              "rawText",
              "evidence"
            ],
            "additionalProperties": false
          },
          "deadlineObservation": {
            "type": "object",
            "description": "이 ITEM에서 관찰된 해당 Action의 마감 시점. 최종 Action deadline은 서버가 여러 Source를 병합한 뒤 결정한다.",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "confirmed",
                  "needs_review",
                  "none"
                ],
                "description": "confirmed=원문에 명확한 마감일, needs_review=마감 개념은 있으나 날짜가 불명확/조건부/내부 충돌, none=마감 정보 없음."
              },
              "date": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date",
                "description": "confirmed인 경우 원문으로 확인되는 YYYY-MM-DD. 추측 금지."
              },
              "datetime": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "마감 시간까지 원문에 명시된 경우만 반환."
              },
              "rawText": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "원문의 마감 표현. 불명확한 경우 판단 근거 보존용."
              },
              "evidence": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "마감 시점을 직접 뒷받침하는 원문 근거."
                  },
                  "locator": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "text_span",
                          "page",
                          "email_section",
                          "calendar_field",
                          "metadata",
                          "unknown"
                        ]
                      },
                      "page": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "section": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "startChar": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "endChar": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "field": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "page",
                      "section",
                      "startChar",
                      "endChar",
                      "field"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "text",
                  "locator"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "status",
              "date",
              "datetime",
              "rawText",
              "evidence"
            ],
            "additionalProperties": false
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "description": "Action 자체가 실제로 존재함을 뒷받침하는 원문 근거. Action마다 최소 1개 필요.",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "description": "행동 요구/선택/확인 필요성을 직접 뒷받침하는 짧은 원문 근거."
                },
                "locator": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "text_span",
                        "page",
                        "email_section",
                        "calendar_field",
                        "metadata",
                        "unknown"
                      ]
                    },
                    "page": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "section": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "startChar": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "endChar": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "field": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "page",
                    "section",
                    "startChar",
                    "endChar",
                    "field"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "text",
                "locator"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "actionType",
          "requirements",
          "conditions",
          "startObservation",
          "deadlineObservation",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "classification",
    "actions"
  ],
  "additionalProperties": false
